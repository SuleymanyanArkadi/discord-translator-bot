# Токен бота (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information)
CLIENT_ID=
# ID сервера для мгновенной регистрации команд (необязательно; пусто — глобально)
GUILD_ID=
# Ключ DeepL API Free (заканчивается на :fx). Пусто — только Google Translate
DEEPL_API_KEY=
# Email для MyMemory (необязательно): лимит 50 000 символов в день вместо 5 000
MYMEMORY_EMAIL=
# Сколько секунд висит кнопка «Показать перевод»
BUTTON_TIMEOUT_SECONDS=7
